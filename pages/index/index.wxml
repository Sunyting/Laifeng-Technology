<view class="search-container" bindtap="openSearch">
  <view class="search-box" aria-label="搜索商品">
    <image class="search-icon" src="../../images/icons/搜索.png"></image>
    <text class="search-placeholder">搜索商品与服务</text>
  </view>
</view>

<view wx:if="{{banners.length}}" class="swiper-container">
  <swiper autoplay indicator-dots circular>
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <image src="{{item.pic}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>
</view>

<view class="recommended-section">
  <view class="section-header">
    <text class="section-title">推荐商品</text>
  </view>
  <view wx:if="{{productsStatus === 'success'}}" class="recommended-list">
    <product-card
      wx:for="{{recommendedProducts}}"
      wx:key="_id"
      product="{{item}}"
      layout="grid"
      bind:cardtap="openProduct"
      bind:addcart="chooseProduct"
    ></product-card>
  </view>
  <status-view
    wx:else
    status="{{productsStatus}}"
    message="{{productsMessage}}"
    action-text="{{productsStatus === 'error' ? '重试' : ''}}"
    bind:action="loadPage"
  ></status-view>
</view>
