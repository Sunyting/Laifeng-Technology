.search-container {
  padding: 18rpx 20rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  height: 68rpx;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 34rpx;
  background: #f9fafb;
  box-sizing: border-box;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
}

.search-placeholder {
  flex: 1;
  color: #98a2b3;
  font-size: 25rpx;
}

.swiper-container {
  width: 100%;
  height: 400rpx;
  background: #ffffff;
}

.swiper-container swiper,
.swiper-container image {
  width: 100%;
  height: 100%;
}

.recommended-section {
  padding: 0 20rpx 32rpx;
  background: #ffffff;
}

.section-header {
  padding: 32rpx 0 22rpx;
}

.section-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 700;
}

.recommended-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}
