/* pages/type/type.wxss */
.category-container {
  display: flex;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 左侧一级分类 */
.first-category {
  width: 120rpx;
  background-color: #f5f5f5;
  overflow-y: auto;
}

.first-item {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 4rpx solid transparent;
  font-size: 28rpx;
  color: #666666;
  background-color: #f5f5f5;
  transition: all 0.3s ease;
}

.first-item.active {
  border-left-color: #ff4444;
  color: #ff4444;
  background-color: #ffffff;
  font-weight: 600;
}

/* 右侧商品列表 */
.product-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start; /* 让内容顶部对齐，减少多余间距 */
  gap: 12rpx 20rpx; /* 垂直12rpx，水平20rpx */
  background-color: #f9f9f9;
}

.product-item {
  width: 48%;
  height: auto;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s ease;
}

.product-item image {
  width: 100%;
  height: 250rpx;
  background-color: #f5f5f5;
}
.product-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.product-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.product-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.3;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.product-bottom {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.product-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  min-width: 0;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff4444;
  font-weight: 600;
}

.price-min {
  font-size: 36rpx;
  color: #ff4444;
  font-weight: 700;
}

.price-range {
  font-size: 28rpx;
  color: #ff4444;
  font-weight: 600;
}

.price-unit {
  font-size: 22rpx;
  color: #ff4444;
}

.price-remark {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #666666;
}

.product-sku-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sku-count {
  font-size: 22rpx;
  color: #666666;
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.total-stock {
  font-size: 22rpx;
  color: #999999;
}
