<view class="category-container">
  <block wx:if="{{categoriesStatus === 'success'}}">
    <scroll-view scroll-y class="first-category">
      <block wx:for="{{firstTypes}}" wx:key="_id">
        <view class="first-item {{currentFirstType === item._id ? 'active' : ''}}" bindtap="switchFirstType" data-id="{{item._id}}">
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>

    <scroll-view scroll-y class="product-list">
      <view wx:if="{{productsStatus === 'success'}}" class="product-list__inner">
        <product-card
          wx:for="{{products}}"
          wx:key="_id"
          product="{{item}}"
          layout="row"
          bind:cardtap="openProduct"
          bind:addcart="chooseProduct"
        ></product-card>
      </view>
      <status-view
        wx:else
        status="{{productsStatus}}"
        message="{{productsMessage}}"
        action-text="{{productsStatus === 'error' ? '重试' : ''}}"
        bind:action="retryProducts"
      ></status-view>
    </scroll-view>
  </block>

  <view wx:else class="category-status">
    <status-view
      status="{{categoriesStatus}}"
      message="{{categoriesStatus === 'error' ? '分类加载失败，请稍后重试' : categoriesStatus === 'empty' ? '暂无商品分类' : ''}}"
      action-text="{{categoriesStatus === 'error' ? '重试' : ''}}"
      bind:action="retryCategories"
    ></status-view>
  </view>
</view>
