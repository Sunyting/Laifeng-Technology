<view class="checkout-page">
  <block wx:if="{{pageStatus === 'success'}}">
    <view wx:if="{{hasOnsiteItems}}" class="section">
      <text class="section__title">上门维修办理方式</text>
      <view class="mode-control">
        <button class="mode-control__button {{onsiteFulfillmentType === 'store' ? 'mode-control__button--active' : ''}}" data-type="store" bindtap="selectFulfillment">到店办理</button>
        <button class="mode-control__button {{onsiteFulfillmentType === 'delivery' ? 'mode-control__button--active' : ''}}" data-type="delivery" bindtap="selectFulfillment">上门服务</button>
      </view>
    </view>

    <view class="section form-section">
      <text class="section__title">联系信息</text>
      <label class="form-row">
        <text class="form-row__label">联系人</text>
        <input class="form-row__input" value="{{contact.name}}" maxlength="30" placeholder="请填写姓名" data-field="name" bindinput="handleContactInput" />
      </label>
      <label class="form-row">
        <text class="form-row__label">手机号</text>
        <input class="form-row__input" value="{{contact.phone}}" type="number" maxlength="11" placeholder="请填写手机号码" data-field="phone" bindinput="handleContactInput" />
      </label>
      <label wx:if="{{onsiteFulfillmentType === 'delivery'}}" class="form-row form-row--multiline">
        <text class="form-row__label">详细地址</text>
        <textarea class="form-row__textarea" value="{{contact.address}}" maxlength="120" auto-height placeholder="街道、门牌号等" data-field="address" bindinput="handleContactInput"></textarea>
      </label>
    </view>

    <view wx:if="{{hasStandardItems}}" class="section">
      <text class="section__title">到店办理商品</text>
      <order-items items="{{standardItems}}"></order-items>
    </view>

    <view wx:if="{{hasOnsiteItems}}" class="section">
      <text class="section__title">上门维修商品</text>
      <order-items items="{{onsiteItems}}"></order-items>
    </view>

    <view class="section form-section">
      <label class="form-row form-row--multiline">
        <text class="form-row__label">订单备注</text>
        <textarea class="form-row__textarea" value="{{note}}" maxlength="200" auto-height placeholder="选填，可填写故障情况或其他需求" bindinput="handleNoteInput"></textarea>
      </label>
    </view>

    <view class="submit-placeholder"></view>
    <view class="submit-bar">
      <view class="submit-total">
        <text class="submit-total__label">{{amountLabel}}</text>
        <text class="submit-total__price">¥{{totalAmountText}}</text>
      </view>
      <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{orderCount > 1 ? '提交2个订单' : '提交订单'}}</button>
    </view>
  </block>

  <status-view wx:else status="{{pageStatus}}" message="{{pageMessage}}" action-text="{{pageStatus === 'empty' ? '去逛逛' : ''}}" bind:action="goShopping"></status-view>
</view>
