.order-detail-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.status-section {
  padding: 36rpx 30rpx;
  background: #1677a7;
  color: #ffffff;
}

.status-section__status,
.status-section__hint {
  display: block;
}

.status-section__countdown {
  display: block;
  margin-top: 12rpx;
  color: #fff8f3;
  font-size: 24rpx;
  font-weight: 600;
}

.status-section__status {
  font-size: 34rpx;
  font-weight: 700;
}

.status-section__hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  opacity: 0.9;
}

.detail-section {
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-bottom: 16rpx solid #f2f4f7;
}

.info-list {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
}

.info-row__label {
  flex: 0 0 130rpx;
  color: #667085;
}

.info-row__value {
  color: #344054;
  text-align: right;
  word-break: break-all;
}

.info-row__value--accent {
  color: #1677a7;
  font-weight: 600;
}

.info-row__value--payment-unpaid {
  color: #c4320a;
  font-weight: 600;
}

.info-row__value--payment-paying,
.info-row__value--payment-refunding {
  color: #1677a7;
  font-weight: 600;
}

.info-row__value--payment-paid {
  color: #027a48;
  font-weight: 600;
}

.info-row__value--payment-closed,
.info-row__value--payment-refunded {
  color: #667085;
  font-weight: 600;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  color: #101828;
  font-size: 29rpx;
  font-weight: 600;
}

.merchant-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.merchant-section__content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.merchant-section__title {
  margin-bottom: 8rpx;
}

.merchant-section__hint {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.merchant-section__phone {
  margin-top: 8rpx;
  color: #1677a7;
  font-size: 27rpx;
  font-weight: 600;
}

.merchant-section__button {
  flex: 0 0 128rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #1677a7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1677a7;
  font-size: 24rpx;
  line-height: 66rpx;
}

.merchant-section__button::after {
  border: 0;
}

.contact-line {
  display: flex;
  gap: 24rpx;
  color: #344054;
  font-size: 25rpx;
}

.contact-address,
.note-text {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eaecf0;
  color: #344054;
  font-size: 23rpx;
}

.amount-row__price {
  color: #e53e3e;
  font-size: 32rpx;
  font-weight: 700;
}

.payment-hint {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.order-note {
  padding: 26rpx 30rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.6;
}

.payment-button,
.orders-button,
.cancel-button,
.refund-button,
.delete-button {
  min-height: 76rpx;
  margin: 8rpx 30rpx 0;
  border: 1rpx solid #1677a7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1677a7;
  font-size: 26rpx;
  line-height: 74rpx;
}

.payment-button {
  border-color: #1677a7;
  background: #1677a7;
  color: #ffffff;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 8rpx 30rpx 0;
}

.order-actions .payment-button,
.order-actions .cancel-button,
.order-actions .refund-button,
.order-actions .delete-button {
  flex: 1 1 45%;
  margin: 0;
}

.cancel-button,
.delete-button {
  border-color: #d0d5dd;
  background: #ffffff;
  color: #475467;
}

.refund-button {
  border-color: #c53030;
  background: #ffffff;
  color: #c53030;
}

.payment-button::after,
.orders-button::after,
.cancel-button::after,
.refund-button::after,
.delete-button::after {
  border: 0;
}
