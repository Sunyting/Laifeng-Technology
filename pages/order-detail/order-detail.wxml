<view class="order-detail-page">
  <block wx:if="{{pageStatus === 'success'}}">
    <view class="status-section">
      <text class="status-section__status">{{order.statusLabel}}</text>
      <text class="status-section__hint">{{order.statusHint}}</text>
      <text wx:if="{{order.paymentCountdownText}}" class="status-section__countdown">{{order.paymentCountdownText}}</text>
    </view>

    <view class="detail-section info-list">
      <view class="info-row">
        <text class="info-row__label">订单编号</text>
        <text class="info-row__value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">下单时间</text>
        <text class="info-row__value">{{order.createdAtText}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">订单类型</text>
        <text class="info-row__value">{{order.orderTypeLabel}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">付款状态</text>
        <text class="info-row__value info-row__value--payment-{{order.paymentStatus}}">{{order.paymentStatusLabel}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">办理方式</text>
        <text class="info-row__value">{{order.fulfillmentLabel}}</text>
      </view>
      <view wx:if="{{order.appointmentText}}" class="info-row">
        <text class="info-row__label">预约时间</text>
        <text class="info-row__value info-row__value--accent">{{order.appointmentText}}</text>
      </view>
    </view>

    <view wx:if="{{order.fulfillmentType === 'delivery'}}" class="detail-section merchant-section">
      <view class="merchant-section__content">
        <text class="section-title merchant-section__title">电话确认预约</text>
        <text class="merchant-section__hint">预约后请联系商家确认上门时间</text>
        <text class="merchant-section__phone">{{merchantPhone}}</text>
      </view>
      <button class="merchant-section__button" bindtap="callMerchant">拨打</button>
    </view>

    <view class="detail-section">
      <text class="section-title">联系信息</text>
      <view class="contact-line">
        <text>{{order.contact.name}}</text>
        <text>{{order.contact.phone}}</text>
      </view>
      <text wx:if="{{order.contact.address}}" class="contact-address">{{order.contact.address}}</text>
    </view>

    <view class="detail-section">
      <text class="section-title">商品明细</text>
      <order-items items="{{order.items}}"></order-items>
      <view class="amount-row">
        <text>{{order.onlinePaymentLabel}}</text>
        <text class="amount-row__price">¥{{order.onlinePayableAmountText}}</text>
      </view>
      <text wx:if="{{order.amountType === 'estimated'}}" class="payment-hint">本次仅支付检查费，后续维修费用检测报价后到店支付。</text>
    </view>

    <view wx:if="{{order.note}}" class="detail-section">
      <text class="section-title">订单备注</text>
      <text class="note-text">{{order.note}}</text>
    </view>

    <view class="order-note">维修、安装及起步价商品以门店确认的最终方案和价格为准。</view>
    <view class="order-actions">
      <button wx:if="{{order.canPay}}" class="payment-button" loading="{{paying}}" disabled="{{paying}}" bindtap="payOrder">{{order.paymentActionText}}</button>
      <button wx:if="{{order.canCancel}}" class="cancel-button" bindtap="cancelOrder">取消订单</button>
      <button wx:if="{{order.canRefund}}" class="refund-button" bindtap="requestRefund">申请退款</button>
      <button wx:if="{{order.canDelete}}" class="delete-button" bindtap="deleteOrder">删除订单</button>
    </view>
    <button class="orders-button" bindtap="goToOrders">查看全部订单</button>
  </block>

  <status-view wx:else status="{{pageStatus}}" message="{{pageMessage}}" action-text="{{pageStatus === 'error' ? '重新加载' : ''}}" bind:action="loadOrder"></status-view>
</view>
