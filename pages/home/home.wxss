.profile-page {
  min-height: 100vh;
  padding-bottom: 44rpx;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.profile-page button {
  line-height: normal;
}

.profile-hero {
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 34rpx 32rpx 38rpx;
  background: #146f91;
  color: #ffffff;
  box-sizing: border-box;
}

.profile-avatar-button {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.profile-avatar--placeholder {
  background: #ffffff;
  color: #146f91;
  font-size: 44rpx;
  font-weight: 700;
}

.profile-identity {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}

.profile-name,
.profile-description {
  display: block;
}

.profile-name {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-description {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.5;
}

.profile-edit {
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 56rpx;
  margin: 0 0 0 16rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 54rpx;
}

.section {
  margin-top: 18rpx;
  padding: 28rpx 28rpx;
  background: #ffffff;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title,
.section-caption {
  display: block;
}

.section-title {
  color: #101828;
  font-size: 29rpx;
  font-weight: 700;
}

.section-caption {
  margin-top: 6rpx;
  color: #98a2b3;
  font-size: 21rpx;
}

.section-link {
  flex: 0 0 auto;
  margin: 0;
  padding: 8rpx 0 8rpx 18rpx;
  background: transparent;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.order-summary {
  display: flex;
  align-items: stretch;
  margin-top: 28rpx;
}

.order-summary__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 25%;
  flex: 1 1 25%;
  min-width: 0;
  height: 94rpx;
  margin: 0;
  padding: 4rpx 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
}

.order-summary__item + .order-summary__item {
  border-left: 1rpx solid #eaecf0;
}

.order-summary__count,
.order-summary__label {
  display: block;
}

.order-summary__count {
  color: #146f91;
  font-size: 34rpx;
  font-weight: 700;
}

.order-summary__count--warm {
  color: #c2410c;
}

.order-summary__count--green {
  color: #067647;
}

.order-summary__label {
  margin-top: 12rpx;
  color: #475467;
  font-size: 21rpx;
  white-space: nowrap;
}

.address-content {
  display: block;
  width: 100%;
  min-height: 100rpx;
  margin: 22rpx 0 0;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #2d8b78;
  border-radius: 4rpx;
  background: #f3faf8;
  text-align: left;
  box-sizing: border-box;
}

.address-contact {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.address-name {
  color: #101828;
  font-size: 26rpx;
  font-weight: 600;
}

.address-phone {
  color: #475467;
  font-size: 23rpx;
}

.address-detail {
  display: block;
  margin-top: 12rpx;
  color: #344054;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.address-empty__title,
.address-empty__description {
  display: block;
}

.address-empty__title {
  color: #344054;
  font-size: 25rpx;
  font-weight: 600;
}

.address-empty__description {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.service-list {
  margin-top: 18rpx;
  background: #ffffff;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 20rpx 30rpx;
  border-radius: 0;
  background: #ffffff;
  text-align: left;
  box-sizing: border-box;
}

.service-row + .service-row {
  border-top: 1rpx solid #eaecf0;
}

.service-row__title,
.service-row__description {
  display: block;
}

.service-row__title {
  color: #101828;
  font-size: 27rpx;
  font-weight: 600;
}

.service-row__description {
  margin-top: 7rpx;
  color: #667085;
  font-size: 22rpx;
}

.service-row__arrow {
  color: #98a2b3;
  font-size: 30rpx;
}

.service-row__action {
  color: #146f91;
  font-size: 24rpx;
  font-weight: 600;
}

.page-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  padding: 18rpx 26rpx;
  border-radius: 6rpx;
  background: rgba(16, 24, 40, 0.78);
  color: #ffffff;
  font-size: 23rpx;
  transform: translate(-50%, -50%);
}

.editor-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 24, 40, 0.48);
}

.editor-panel {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 8rpx 8rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 700;
}

.editor-close {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #f2f4f7;
  color: #475467;
  font-size: 38rpx;
  line-height: 60rpx;
}

.profile-form,
.address-form {
  margin-top: 28rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  width: 100%;
  height: 116rpx;
  margin: 0 0 22rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 6rpx;
  background: #ffffff;
  text-align: left;
}

.avatar-picker__image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
}

.avatar-picker__placeholder {
  background: #e8f4f7;
  color: #146f91;
  font-size: 34rpx;
  font-weight: 700;
}

.avatar-picker__text {
  margin-left: 22rpx;
  color: #146f91;
  font-size: 25rpx;
  font-weight: 600;
}

.form-field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 6rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.form-field + .form-field {
  margin-top: 18rpx;
}

.form-field--textarea {
  align-items: flex-start;
  min-height: 136rpx;
  padding-top: 26rpx;
  padding-bottom: 20rpx;
}

.form-label {
  flex: 0 0 144rpx;
  color: #344054;
  font-size: 25rpx;
}

.form-input,
.form-textarea {
  min-width: 0;
  flex: 1;
  color: #101828;
  font-size: 25rpx;
}

.form-textarea {
  min-height: 84rpx;
  line-height: 1.5;
}

.editor-save {
  width: 100%;
  height: 88rpx;
  margin: 30rpx 0 0;
  border-radius: 6rpx;
  background: #146f91;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.editor-save[disabled] {
  background: #98a2b3;
  color: #ffffff;
}
