.orders-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.order-filters {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.order-filters__inner {
  display: inline-flex;
  min-width: 100%;
}

.order-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 68rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 6rpx;
  background: #ffffff;
  color: #475467;
  font-size: 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.order-filter:last-child {
  margin-right: 0;
}

.order-filter--active {
  border-color: #1677a7;
  background: #1677a7;
  color: #ffffff;
  font-weight: 600;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  overflow: hidden;
  padding: 0 22rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 8rpx;
  background: #ffffff;
}

.order-card__header,
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
}

.order-card__header {
  border-bottom: 1rpx solid #eaecf0;
}

.order-card__number,
.order-card__time,
.order-card__type {
  display: block;
}

.order-card__number {
  color: #101828;
  font-size: 24rpx;
  font-weight: 600;
}

.order-card__time {
  margin-top: 6rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

.order-card__type {
  margin-top: 6rpx;
  color: #667085;
  font-size: 21rpx;
}

.order-card__status {
  flex: 0 0 auto;
  color: #1677a7;
  font-size: 24rpx;
  font-weight: 600;
}

.order-card__statuses {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-card__payment {
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
}

.order-card__payment--unpaid {
  background: #fff4ed;
  color: #c4320a;
}

.order-card__payment--paying,
.order-card__payment--refunding {
  background: #eef8fc;
  color: #1677a7;
}

.order-card__payment--paid {
  background: #ecfdf3;
  color: #027a48;
}

.order-card__payment--closed,
.order-card__payment--refunded {
  background: #f2f4f7;
  color: #667085;
}

.order-card__appointment {
  margin: 0 -22rpx;
  padding: 16rpx 22rpx;
  background: #eef8fc;
  color: #1677a7;
  font-size: 23rpx;
  font-weight: 600;
}

.order-card__footer {
  border-top: 1rpx solid #eaecf0;
  color: #667085;
  font-size: 22rpx;
}

.order-card__amount {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.order-card__price {
  color: #e53e3e;
  font-size: 29rpx;
  font-weight: 700;
}
