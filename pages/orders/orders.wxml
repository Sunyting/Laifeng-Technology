<view class="orders-page">
  <scroll-view wx:if="{{pageStatus !== 'loginRequired'}}" class="order-filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="order-filters__inner">
      <view
        wx:for="{{filters}}"
        wx:key="value"
        class="order-filter {{selectedFilter === item.value ? 'order-filter--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectFilter"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{pageStatus === 'success'}}" class="order-list">
    <view wx:for="{{orders}}" wx:key="_id" class="order-card" data-id="{{item._id}}" bindtap="openOrder">
      <view class="order-card__header">
        <view>
          <text class="order-card__number">订单 {{item.orderNo}}</text>
          <text class="order-card__time">{{item.createdAtText}}</text>
          <text class="order-card__type">{{item.orderTypeLabel}} · {{item.fulfillmentLabel}}</text>
        </view>
        <view class="order-card__statuses">
          <text class="order-card__payment order-card__payment--{{item.paymentStatus}}">{{item.paymentStatusLabel}}</text>
          <text class="order-card__status">{{item.statusLabel}}</text>
        </view>
      </view>
      <order-items items="{{item.items}}"></order-items>
      <view wx:if="{{item.appointmentText}}" class="order-card__appointment">预约上门：{{item.appointmentText}}</view>
      <view wx:if="{{item.paymentCountdownText}}" class="order-card__countdown">{{item.paymentCountdownText}}</view>
      <view class="order-card__footer">
        <text class="order-card__count">共 {{item.totalQuantity}} 件</text>
        <view class="order-card__amount">
          <text>{{item.onlinePaymentLabel}}</text>
          <text class="order-card__price">¥{{item.onlinePayableAmountText}}</text>
        </view>
      </view>
      <view wx:if="{{item.canCancel || item.canRefund || item.canDelete}}" class="order-card__actions">
        <button wx:if="{{item.canCancel}}" class="order-card__cancel" data-id="{{item._id}}" catchtap="cancelOrder">取消订单</button>
        <button wx:if="{{item.canRefund}}" class="order-card__refund" data-id="{{item._id}}" catchtap="requestRefund">申请退款</button>
        <button wx:if="{{item.canDelete}}" class="order-card__delete" data-id="{{item._id}}" catchtap="deleteOrder">删除订单</button>
      </view>
    </view>
  </view>

  <status-view
    wx:else
    status="{{pageStatus === 'loginRequired' ? 'empty' : pageStatus}}"
    message="{{pageMessage}}"
    action-text="{{pageStatus === 'loginRequired' ? '去登录' : (pageStatus === 'error' ? '重新加载' : (pageStatus === 'empty' ? (allOrders.length ? '查看全部' : '去逛逛') : ''))}}"
    bind:action="handleStatusAction"
  ></status-view>
</view>
