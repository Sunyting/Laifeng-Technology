<view class="detail-page">
  <block wx:if="{{pageStatus === 'success'}}">
    <view class="gallery">
      <swiper wx:if="{{gallery.length && !imageFailed}}" class="gallery__swiper" indicator-dots="{{gallery.length > 1}}" circular="{{gallery.length > 1}}">
        <swiper-item wx:for="{{gallery}}" wx:key="*this">
          <image class="gallery__image" src="{{item}}" mode="aspectFit" binderror="handleImageError"></image>
        </swiper-item>
      </swiper>
      <view wx:else class="gallery__placeholder">
        <text class="gallery__name">{{product.name}}</text>
        <text class="gallery__status">图片待补</text>
      </view>
    </view>

    <view class="detail-section summary">
      <price-view price-range="{{product.priceRange}}" price-meta="{{product.priceMeta}}" sku="{{selectedSku}}" item-type="{{product.itemType}}" size="large"></price-view>
      <text class="summary__name">{{product.name}}</text>
      <text wx:if="{{product.description}}" class="summary__description">{{product.description}}</text>
    </view>

    <view class="detail-section selector-section">
      <view class="section-heading">
        <text>选择规格</text>
        <text class="stock">库存 {{selectedSku ? selectedSku.stock : 0}}</text>
      </view>
      <sku-selector
        levels="{{product.specs.levels}}"
        selected-values="{{selectedValues}}"
        sku-list="{{product.SKUlist}}"
        bind:select="selectSpec"
      ></sku-selector>
      <text wx:if="{{showSelectorHint && product.specs.levels.length}}" class="selector-hint">请选择需要的商品规格</text>

      <view class="quantity-row">
        <text class="quantity-label">数量</text>
        <view class="stepper">
          <button class="stepper__button" disabled="{{quantity <= 1}}" bindtap="decreaseQuantity" aria-label="减少数量">−</button>
          <text class="stepper__value">{{quantity}}</text>
          <button class="stepper__button" disabled="{{!selectedSku || quantity >= selectedSku.stock || quantity >= 99}}" bindtap="increaseQuantity" aria-label="增加数量">＋</button>
        </view>
      </view>
    </view>

    <view class="detail-section service-note">
      <text class="section-title">购买说明</text>
      <text>价格与库存以当前所选规格为准。服务类商品加入购物车后，请联系门店确认服务时间和最终方案。</text>
    </view>

    <view class="bottom-placeholder"></view>
    <view class="action-bar">
      <button class="cart-shortcut" bindtap="goToCart">
        <image src="/images/icons/购物车.png" mode="aspectFit"></image>
        <text>购物车</text>
      </button>
      <button class="action-button action-button--cart" disabled="{{!selectedSku || selectedSku.stock <= 0}}" bindtap="addToCart">加入购物车</button>
      <button class="action-button action-button--buy" disabled="{{!selectedSku || selectedSku.stock <= 0}}" bindtap="buyNow">立即购买</button>
    </view>
  </block>

  <status-view
    wx:else
    status="{{pageStatus}}"
    message="{{pageMessage}}"
    action-text="{{pageStatus === 'error' ? '重新加载' : ''}}"
    bind:action="loadProduct"
  ></status-view>
</view>
