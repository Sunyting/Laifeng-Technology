<view class="search-page">
  <view class="search-bar">
    <view class="search-box">
      <image class="search-icon" src="/images/icons/搜索.png" mode="aspectFit"></image>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索商品或服务"
        confirm-type="search"
        focus
        bindinput="handleInput"
        bindconfirm="handleConfirm"
        aria-label="搜索商品或服务"
      />
      <button wx:if="{{keyword}}" class="clear-button" bindtap="clearSearch" aria-label="清空搜索">×</button>
    </view>
    <button class="search-button" bindtap="handleConfirm">搜索</button>
  </view>

  <view wx:if="{{searchStatus === 'success'}}" class="result-list">
    <view wx:for="{{products}}" wx:key="_id" class="result-item">
      <product-card
        product="{{item}}"
        layout="row"
        bind:cardtap="openProduct"
        bind:addcart="chooseProduct"
      ></product-card>
    </view>
  </view>

  <status-view
    wx:else
    status="{{searchStatus === 'idle' ? 'empty' : searchStatus}}"
    message="{{searchMessage}}"
    action-text="{{searchStatus === 'error' ? '重新搜索' : ''}}"
    bind:action="searchProducts"
  ></status-view>
</view>
