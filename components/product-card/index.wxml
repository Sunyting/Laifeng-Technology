<view class="product product--{{layout}}" bindtap="handleTap" hover-class="product--pressed" aria-label="查看{{product.name}}">
  <view class="product__media">
    <image
      wx:if="{{product.image && !imageFailed}}"
      class="product__image"
      src="{{product.image}}"
      mode="aspectFill"
      lazy-load
      binderror="handleImageError"
    ></image>
    <view wx:else class="product__placeholder">
      <text class="product__placeholder-name">{{product.name}}</text>
      <text class="product__placeholder-status">图片待补</text>
    </view>
  </view>

  <view class="product__content">
    <text class="product__name">{{product.name}}</text>
    <text wx:if="{{layout === 'row' && product.description}}" class="product__description">{{product.description}}</text>

    <view class="product__bottom">
      <price-view price-range="{{product.priceRange}}" price-meta="{{product.priceMeta}}" size="{{layout === 'row' ? 'medium' : 'small'}}"></price-view>
      <button
        wx:if="{{showAction}}"
        class="product__action"
        catchtap="handleAdd"
        aria-label="选择{{product.name}}规格"
      >
        <image src="/images/icons/购物车.png" mode="aspectFit"></image>
      </button>
    </view>

    <view class="product__meta">
      <text>{{product.skuCount}}种规格</text>
      <text>库存{{product.totalStock}}</text>
    </view>
  </view>
</view>
