.product {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.product--pressed {
  opacity: 0.82;
}

.product__media {
  flex-shrink: 0;
  overflow: hidden;
  background: #f2f4f7;
}

.product__image,
.product__placeholder {
  width: 100%;
  height: 100%;
}

.product__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
  color: #667085;
  text-align: center;
}

.product__placeholder-name {
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-all;
}

.product__placeholder-status {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #98a2b3;
}

.product__content {
  min-width: 0;
  padding: 18rpx;
  box-sizing: border-box;
}

.product__name {
  display: -webkit-box;
  overflow: hidden;
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product__description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.product__bottom {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 56rpx;
  align-items: center;
  min-height: 56rpx;
  gap: 12rpx;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.product__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  min-height: 56rpx;
  max-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #e53e3e;
  box-sizing: border-box;
  line-height: 1;
}

.product__action::after {
  border: 0;
}

.product__action image {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

.product__meta {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 1.3;
}

.product--grid .product__media {
  width: 100%;
  height: 260rpx;
}

.product--grid .product__content {
  min-height: 190rpx;
}

.product--row {
  display: flex;
  width: 100%;
}

.product--row .product__media {
  width: 190rpx;
  height: 190rpx;
}

.product--row .product__content {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}
