.status {
  display: flex;
  min-height: 320rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  color: #667085;
  text-align: center;
}

.status__spinner {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
  border: 5rpx solid #e4e7ec;
  border-top-color: #30a3df;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.status__message {
  font-size: 26rpx;
  line-height: 1.5;
}

.status__action {
  min-height: 64rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #ffffff;
  color: #344054;
  font-size: 26rpx;
  line-height: 64rpx;
}

.status__action::after {
  border: 0;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .status__spinner {
    animation: none;
  }
}
