<view class="status" aria-live="polite">
  <view wx:if="{{status === 'loading'}}" class="status__spinner"></view>
  <text class="status__message">{{message || (status === 'loading' ? '正在加载' : status === 'error' ? '加载失败' : '暂无数据')}}</text>
  <button wx:if="{{actionText && status !== 'loading'}}" class="status__action" bindtap="handleAction">{{actionText}}</button>
</view>
